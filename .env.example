# Copy to .env.local and fill in real values. .env.local is gitignored.

# Supabase project — Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret used by /api/webhooks/supabase-auth to verify the caller.
# Generate with `openssl rand -hex 32`.
SUPABASE_WEBHOOK_SECRET=

# Origin of the deployed app, used to build magic-link redirect URLs.
# In production this is your Vercel URL; locally it's http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
